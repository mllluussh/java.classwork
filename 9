import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        int n = scanner.nextInt();
        int[] arr = new int[n];
        
        for (int i = 0; i < n; i++) {
            arr[i] = scanner.nextInt();
        }
        int maxVal = arr[0];
        int maxIdx = 0;
        
        int minVal = arr[0];
        int minIdx = 0;
        for (int i = 1; i < n; i++) {
            if (arr[i] > maxVal) {
                maxVal = arr[i];
                maxIdx = i;
            }
            if (arr[i] < minVal) {
                minVal = arr[i];
                minIdx = i;
            }
        }
        
        System.out.println("Максимум: " + maxVal + " (индекс " + maxIdx + ")");
        System.out.println("Минимум: " + minVal + " (индекс " + minIdx + ")");
    }
}
